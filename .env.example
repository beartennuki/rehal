REHAL_ENV_TYPE=DEV
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
MONGO_URI=mongodb://localhost:27017
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1
REHAL_HOST=0.0.0.0
REHAL_PORT=5500
REHAL_RELOAD=true

CANONICAL_TOPIC_MONGO_DB_NAME=DEV_CANONICAL_TOPIC_REHAL_DB
CANONICAL_TOPIC_COLLECTION_NAME=DEV_canonical_topic
OPENAI_CANONICAL_TOPIC_JSON_MODEL=gpt-4.1-mini
OPENAI_CANONICAL_TOPIC_WRITER_MODEL=gpt-4.1
OPENAI_CANONICAL_TOPIC_EMBEDDING_MODEL=text-embedding-3-small
CANONICAL_TOPIC_MIN_SUBTOPICS=4
CANONICAL_TOPIC_MAX_SUBTOPICS=8
CANONICAL_TOPIC_MIN_SOURCES_PER_SUBTOPIC=3
CANONICAL_TOPIC_MAX_RESULTS_PER_SEARCH=10
CANONICAL_TOPIC_SEARCH_MAX_TIER=3
CANONICAL_TOPIC_RAW_CONTENT_LIMIT=12000
